---
import QuickWriteModal from './QuickWriteModal.astro';

interface Props {
  page?: 'day' | 'trends' | 'zones' | 'inspector';
}
const { page = 'day' } = Astro.props;
---

<header class="topbar" data-page={page}>
  <div class="topbar-inner">
  <div class="topbar-left">
    <span class="live"><span class="live-dot"></span>LIVE</span>
    <span class="topbar-name" id="gh-profile-name">Google Health</span>
    <span class="topbar-device" id="gh-device-name"></span>
  </div>
  
  <div class="topbar-center">
    <nav class="view-switch" aria-label="Sections">
      <a href="/" class:list={{ on: page === 'day' }} aria-current={page === 'day' ? 'page' : undefined}>Overview</a>
      <a href="/trends" class:list={{ on: page === 'trends' }} aria-current={page === 'trends' ? 'page' : undefined}>Trends</a>
      <a href="/zones" class:list={{ on: page === 'zones' }} aria-current={page === 'zones' ? 'page' : undefined}>HR Zones</a>
      <a href="/inspector" class:list={{ on: page === 'inspector' }} aria-current={page === 'inspector' ? 'page' : undefined}>RAW</a>
    </nav>

    <div id="gh-date-nav" class="date-nav" hidden={page !== 'day'}>
      <button class="tb-btn" id="gh-prev" title="Previous day" aria-label="Previous day">‹</button>
      <div class="tb-date">
        <span id="gh-date-label">…</span>
        <input type="date" id="gh-date-input" title="Pick a date" aria-label="Pick a date" />
      </div>
      <button class="tb-btn" id="gh-next" title="Next day" aria-label="Next day">›</button>
    </div>
  </div>

  <div class="topbar-right">
    <button
      id="gh-lang-btn"
      class="tb-btn ghost-btn lang-btn"
      type="button"
      aria-label="Switch language"
      title="Language"
    >RU</button>
    <button
      id="gh-settings-btn"
      class="tb-btn ghost-btn settings-btn"
      type="button"
      aria-label="Dashboard settings"
      aria-expanded="false"
      title="Dashboard settings"
    >⚙</button>
    <button id="quick-add-btn" class="quick-add-btn">+ Entry</button>
    <button
      id="gh-refresh-btn"
      class="tb-btn ghost-btn"
      type="button"
      title="Refresh data"
      aria-label="Refresh data"
    >⟳</button>
    <span class="conn-error" id="gh-conn-error" hidden>no connection to Google Health</span>
    <label class="autorefresh" hidden={page !== 'day'}>
      <input type="checkbox" id="gh-autorefresh" checked /> auto 60 s
    </label>
  </div>
  </div>

  <!-- Dashboard settings popover -->
  <div class="settings-popover" id="gh-settings-panel" hidden aria-label="Dashboard settings panel">
    <div class="settings-head">
      <span class="label">Show cards</span>
      <button id="gh-settings-compact" class="tb-btn ghost-btn compact-toggle" type="button" aria-pressed="false">Compact</button>
      <button id="gh-settings-reset" class="tb-btn ghost-btn" type="button">Reset</button>
    </div>
    <div class="settings-cards" id="gh-settings-cards">
      <label><input type="checkbox" data-card="vitals" checked /> Vitals</label>
      <label><input type="checkbox" data-card="activity" checked /> Activity</label>
      <label><input type="checkbox" data-card="heart" checked /> Heart</label>
      <label><input type="checkbox" data-card="sleep" checked /> Sleep</label>
      <label><input type="checkbox" data-card="body" checked /> Body</label>
      <label><input type="checkbox" data-card="exercise" checked /> Exercise</label>
      <label><input type="checkbox" data-card="misc" checked /> Misc</label>
    </div>
  </div>
</header>

<QuickWriteModal />

<script>
  import { loadSummary, loadStatus, getStatus, subscribeStatus } from '@lib/store';
  import { $, addDaysClient, fetchJson, fmtDateDot, todayLocal } from '@lib/ui';
  import type { PairedDevice } from '@lib/gh-types';
  import { CARD_IDS, readSettings, toggleCard, resetSettings, updateSettings } from '@lib/settings';
  import { currentLocale } from '@lib/i18n';

  const page = document.querySelector('.topbar')?.getAttribute('data-page') ?? 'day'

  // ── Language toggle (en/ru) ──
  const LANG_KEY = 'gh:lang';
  function applyLang(lang: 'en' | 'ru'): void {
    window.localStorage.setItem(LANG_KEY, lang);
    document.documentElement.lang = lang;
    document.dispatchEvent(new CustomEvent('gh:locale', { detail: { lang } }));
    const btn = $('#gh-lang-btn');
    if (btn) btn.textContent = lang === 'ru' ? 'EN' : 'RU'; // shows the target
  }
  $('#gh-lang-btn')?.addEventListener('click', () => {
    const cur = currentLocale(window.localStorage.getItem(LANG_KEY), document.documentElement.lang);
    applyLang(cur === 'ru' ? 'en' : 'ru');
  });
  applyLang(currentLocale(window.localStorage.getItem(LANG_KEY), document.documentElement.lang));

  // ── Dashboard settings panel (card visibility + compact) ──
  function applySettingsPanel(): void {
    const s = readSettings(window.localStorage);
    document.querySelectorAll<HTMLInputElement>('#gh-settings-cards input[data-card]').forEach((el) => {
      const id = el.dataset.card as (typeof CARD_IDS)[number] | undefined;
      if (id) el.checked = s.visible[id];
    });
    const compactBtn = $('#gh-settings-compact') as HTMLButtonElement | null;
    compactBtn?.setAttribute('aria-pressed', String(s.compact));
  }
  $('#gh-settings-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    const panel = $('#gh-settings-panel');
    const open = panel ? !panel.hidden : false;
    if (panel) panel.hidden = open;
    $('#gh-settings-btn')?.setAttribute('aria-expanded', String(!open));
    if (!open) applySettingsPanel();
  });
  document.addEventListener('click', (e) => {
    const panel = $('#gh-settings-panel');
    if (!panel || panel.hidden) return;
    if (!(e.target as Element)?.closest('#gh-settings-btn, #gh-settings-panel')) panel.hidden = true;
  });
  $('#gh-settings-cards')?.addEventListener('change', (e) => {
    const input = (e.target as HTMLInputElement | null);
    const id = input?.dataset.card as (typeof CARD_IDS)[number] | undefined;
    if (!id || !input) return;
    toggleCard(window.localStorage, id, input.checked);
    window.dispatchEvent(new CustomEvent('gh:settings'));
  });
  $('#gh-settings-compact')?.addEventListener('click', (e) => {
    e.stopPropagation();
    const s = readSettings(window.localStorage);
    updateSettings(window.localStorage, { compact: !s.compact });
    window.dispatchEvent(new CustomEvent('gh:settings'));
    applySettingsPanel();
  });
  $('#gh-settings-reset')?.addEventListener('click', () => {
    resetSettings(window.localStorage);
    window.dispatchEvent(new CustomEvent('gh:settings'));
    applySettingsPanel();
  });

  $('#quick-add-btn')?.addEventListener('click', () => {
    window.openQuickWriteModal?.('weight');
  });

  async function loadIdentity(): Promise<void> {
    try {
      // v4 /profile doesn't return name — header is neutral, we only pull devices
      const devices = await fetchJson<{ pairedDevices?: PairedDevice[] }>('/api/devices');
      $('#gh-profile-name')!.textContent = 'Google Health';
      const dev = devices.pairedDevices?.[0];
      if (dev) {
        $('#gh-device-name')!.textContent = dev.deviceVersion ?? dev.deviceDisplayName ?? [dev.manufacturer, dev.model].filter(Boolean).join(' ');
      }
      $('#gh-conn-error')!.hidden = true;
    } catch {
      $('#gh-profile-name')!.textContent = 'Google Health';
      $('#gh-conn-error')!.hidden = false;
    }
  }
  void loadIdentity();
  void loadStatus();

  // Reflect /api/status: if OAuth is not configured, show "setup required"
  // instead of a generic connection error (the conn-error span is reused).
  const connEl = $('#gh-conn-error');
  function renderStatus(): void {
    const s = getStatus();
    if (!s) return;
    const hasSuggestion = s.oauth && (!s.oauth.hasClientId || !s.oauth.hasClientSecret || !s.oauth.hasRefreshToken);
    connEl!.hidden = !hasSuggestion;
    connEl!.textContent = 'setup required';
  }
  subscribeStatus(renderStatus);

  if (page === 'day') {
    const label = $('#gh-date-label')!;
    const input = $('#gh-date-input') as HTMLInputElement;
    const prevBtn = $('#gh-prev') as HTMLButtonElement;
    const nextBtn = $('#gh-next') as HTMLButtonElement;
    const autoChk = $('#gh-autorefresh') as HTMLInputElement;

    const urlDate = new URLSearchParams(location.search).get('date');
    let date = urlDate && /^\d{4}-\d{2}-\d{2}$/.test(urlDate) ? urlDate : todayLocal();
    const today = todayLocal();
    input.max = today;

    const setDate = (d: string): void => {
      date = d;
      document.documentElement.dataset.ghDate = d;
      label.textContent = fmtDateDot(d);
      input.value = d;
      nextBtn.disabled = d >= today;
      window.dispatchEvent(new CustomEvent('gh:date', { detail: { date: d } }));
      void loadSummary(d);
    };

    prevBtn.addEventListener('click', () => setDate(addDaysClient(date, -1)));
    nextBtn.addEventListener('click', () => {
      if (date < today) setDate(addDaysClient(date, 1));
    });
    input.addEventListener('change', () => {
      if (input.value && input.value <= today) setDate(input.value);
    });

    // Date is shown by Doto label; native input is hidden but picker opens
    // on label click. showPicker isn't everywhere — fallback to focus().
    label.addEventListener('click', () => {
      const el = input as HTMLInputElement & { showPicker?: () => void };
      if (typeof el.showPicker === 'function') {
        try { el.showPicker(); } catch { input.focus(); }
      } else {
        input.focus();
      }
    });

    const autoParam = new URLSearchParams(location.search).get('autorefresh');
    autoChk.checked = autoParam !== '0';
    // Auto-refresh interval is now user-configurable (Dashboard settings);
    // persists across sessions. 0 = off.
    const settings = readSettings(window.localStorage);
    const refreshSec = settings.refreshSec > 0 ? settings.refreshSec : 0;
    if (refreshSec === 0) autoChk.checked = false;

    let timer: ReturnType<typeof setInterval> | null = null;
    const scheduleAuto = (): void => {
      if (timer) clearInterval(timer);
      const sec = readSettings(window.localStorage).refreshSec;
      if (autoChk.checked && sec > 0) {
        timer = setInterval(() => {
          // Past days are immutable — don't waste quota and don't trigger cards.
          if (date >= today) void loadSummary(date);
        }, sec * 1000);
      }
    };
    autoChk.addEventListener('change', () => {
      updateSettings(window.localStorage, { refreshSec: autoChk.checked ? 60 : 0 });
      scheduleAuto();
    });
    scheduleAuto();
    // Manual refresh: re-read today's data immediately (e.g. right after a
    // modal write or when the connection recovers). Past days are immutable —
    // refreshing would only waste quota, so it's limited to today.
    $('#gh-refresh-btn')?.addEventListener('click', () => {
      if (date >= today) {
        const btn = $('#gh-refresh-btn');
        btn?.classList.add('spinning');
        void Promise.all([loadSummary(date), loadIdentity(), loadStatus(true)])
          .catch(() => undefined)
          .finally(() => btn?.classList.remove('spinning'));
      }
    });

    // Keyboard shortcuts: ←/→ day, r refresh, t today.
    window.addEventListener('keydown', (e) => {
      if (e.repeat || e.ctrlKey || e.metaKey || e.altKey) return;
      if (e.key === 'ArrowLeft') setDate(addDaysClient(date, -1));
      else if (e.key === 'ArrowRight') setDate(addDaysClient(date, 1));
      else if (e.key.toLowerCase() === 'r') {
        if (date >= today) $('#gh-refresh-btn')?.click();
      } else if (e.key.toLowerCase() === 't') setDate(todayLocal());
    });
    setDate(date);
  } else {
    document.documentElement.dataset.ghDate = todayLocal();
  }
</script>

<style>
  .view-switch {
    display: inline-flex;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0;
  }
  .view-switch a {
    position: relative;
    padding: 6px 13px;
    border-right: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .view-switch a:last-child { border-right: none; }
  .view-switch a:hover { color: var(--text); }
  .view-switch a:active { background: var(--panel-2); color: var(--text); }
  .view-switch a.on {
    color: var(--text);
    background: var(--panel-2);
  }
  .view-switch a.on::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-50%);
  }
  .view-switch a.on { padding-left: 15px; }
  .tb-btn.ghost-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-dim);
    border-radius: 2px;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    padding: 6px 10px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tb-btn.ghost-btn:hover {
    color: var(--text);
    border-color: var(--border-hover);
  }
  .tb-btn.ghost-btn:active {
    color: var(--text);
    background: var(--panel-2);
  }
  .tb-btn.ghost-btn.spinning {
    pointer-events: none;
    opacity: 0.7;
    animation: gh-spin 0.9s linear infinite;
  }
  @keyframes gh-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tb-btn.ghost-btn.spinning { animation: none; }
  }
  .lang-btn { min-width: 32px; }
  .settings-btn { min-width: 30px; }
  .settings-popover {
    position: absolute;
    top: calc(100% - 6px);
    right: 20px;
    z-index: 60;
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    min-width: 220px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }
  .settings-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .settings-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 14px;
  }
  .settings-cards label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-dim);
    cursor: pointer;
  }
  .settings-cards input { accent-color: var(--accent-text); }
  .compact-toggle[aria-pressed="true"] { color: var(--text); border-color: var(--border-hover); }
  .quick-add-btn {
    background: var(--text);
    color: #000;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    padding: 7px 14px;
    border-radius: 2px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .quick-add-btn:hover {
    opacity: 0.85;
  }
  .quick-add-btn:active {
    opacity: 0.7;
  }

  /* Tablet/phone: larger touch targets for tabs and entry button.
     Global CSS doesn't override these scoped selectors, so here they are. */
  @media (max-width: 900px) {
    .view-switch a { padding: 11px 13px; }
    .quick-add-btn { padding: 11px 14px; }
  }
</style>
