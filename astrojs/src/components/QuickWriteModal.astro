---
/**
 * Quick data entry modal — available on every page.
 * Supports: Weight, Water, Sleep, Workout, Nutrition, RAW JSON.
 */
---

<div id="quick-write-modal" class="modal-backdrop" hidden>
  <div class="modal-card panel" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-header">
      <h3 id="modal-title">Data Entry</h3>
      <button id="modal-close-btn" class="tb-btn" aria-label="Close">&#x2715;</button>
    </div>
    
    <div class="modal-tabs" role="tablist" aria-label="Entry type">
      <button class="tab-btn active" data-tab="weight" id="tab-weight" role="tab" aria-selected="true" aria-controls="form-weight">WGT</button>
      <button class="tab-btn" data-tab="hydration" id="tab-hydration" role="tab" aria-selected="false" aria-controls="form-hydration">H₂O</button>
      <button class="tab-btn" data-tab="sleep" id="tab-sleep" role="tab" aria-selected="false" aria-controls="form-sleep">SLP</button>
      <button class="tab-btn" data-tab="exercise" id="tab-exercise" role="tab" aria-selected="false" aria-controls="form-exercise">WRK</button>
      <button class="tab-btn" data-tab="nutrition" id="tab-nutrition" role="tab" aria-selected="false" aria-controls="form-nutrition">FD</button>
      <button class="tab-btn" data-tab="raw" id="tab-raw" role="tab" aria-selected="false" aria-controls="form-raw">RAW</button>
    </div>

    <div class="modal-body">
      <!-- 1. Weight -->
      <form id="form-weight" class="tab-content active" role="tabpanel" aria-labelledby="tab-weight" tabindex="0">
        <label>Weight (kg):
          <input type="number" step="0.1" name="weightKg" placeholder="70.0" required />
        </label>
        <label>Time:
          <input type="datetime-local" name="timestamp" id="weight-time" />
        </label>
        <button type="submit" class="submit-btn">Save weight</button>
      </form>

      <!-- 2. Water -->
      <form id="form-hydration" class="tab-content" role="tabpanel" aria-labelledby="tab-hydration" tabindex="0">
        <label>Time:
          <input type="datetime-local" name="startTime" id="hydration-time" />
        </label>
        <p class="form-hint">Google Health API v4 stores only the time of intake — volume is not recorded.</p>
        <button type="submit" class="submit-btn">Log water</button>
      </form>

      <!-- 3. Sleep -->
      <form id="form-sleep" class="tab-content" role="tabpanel" aria-labelledby="tab-sleep" tabindex="0">
        <label>Sleep start:
          <input type="datetime-local" name="startTime" required />
        </label>
        <label>Sleep end:
          <input type="datetime-local" name="endTime" required />
        </label>
        <p class="form-hint">API does not support titles or notes for sleep sessions.</p>
        <button type="submit" class="submit-btn">Save sleep session</button>
      </form>

      <!-- 4. Workout -->
      <form id="form-exercise" class="tab-content" role="tabpanel" aria-labelledby="tab-exercise" tabindex="0">
        <label>Exercise type:
          <select name="exerciseType">
            <option value="RUNNING">Running</option>
            <option value="WALKING">Walking</option>
            <option value="CYCLING">Cycling</option>
            <option value="STRENGTH_TRAINING">Strength Training</option>
            <option value="SWIMMING">Swimming</option>
            <option value="YOGA">Yoga</option>
            <option value="HIIT">HIIT</option>
          </select>
        </label>
        <label>Start:
          <input type="datetime-local" name="startTime" required />
        </label>
        <label>End:
          <input type="datetime-local" name="endTime" required />
        </label>
        <p class="form-hint">API does not support exercise titles.</p>
        <button type="submit" class="submit-btn">Log workout</button>
      </form>

      <!-- 5. Nutrition -->
      <form id="form-nutrition" class="tab-content" role="tabpanel" aria-labelledby="tab-nutrition" tabindex="0">
        <label>Meal type:
          <select name="mealType">
            <option value="BREAKFAST">Breakfast</option>
            <option value="LUNCH">Lunch</option>
            <option value="DINNER">Dinner</option>
            <option value="SNACK">Snack</option>
          </select>
        </label>
        <label>Time:
          <input type="datetime-local" name="startTime" id="nutrition-time" />
        </label>
        <button type="submit" class="submit-btn">Log meal</button>
      </form>

      <!-- 6. RAW JSON -->
      <form id="form-raw" class="tab-content" role="tabpanel" aria-labelledby="tab-raw" tabindex="0">
        <label>Data type (dataType):
          <input type="text" name="dataType" placeholder="steps" required />
        </label>
        <label>JSON body:
          <textarea name="body" rows="6" placeholder='{"steps": {"interval": {"startTime": "..."}, "count": 100}}' required></textarea>
        </label>
        <button type="submit" class="submit-btn">Submit RAW JSON</button>
      </form>

      <div id="modal-status" class="status-box" role="status" aria-live="polite" hidden></div>
    </div>
  </div>
</div>

<script>
  import { loadSummary } from '@lib/store';
  import { getDate } from '@lib/ui';

  const modal = document.getElementById('quick-write-modal');
  const modalCard = modal?.querySelector<HTMLElement>('.modal-card') ?? null;
  const closeBtn = document.getElementById('modal-close-btn');
  const tabs = document.querySelectorAll('.modal-tabs .tab-btn');
  const contents = document.querySelectorAll('.tab-content');
  const statusBox = document.getElementById('modal-status');
  /** Element that had focus before the modal opened — we restore focus to it on close. */
  let lastFocused: HTMLElement | null = null;
  /** Delayed close after a successful write (cancelled in closeModal). */
  let closeTimer: ReturnType<typeof setTimeout> | null = null;
  /** There was a successful write — refresh the dashboard on ANY modal close. */
  let pendingRefresh = false;

  function closeModal(): void {
    if (!modal) return;
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
    modal.hidden = true;
    document.body.style.overflow = '';
    lastFocused?.focus();
    lastFocused = null;
    // The refresh must not be lost if the user closed the modal themselves
    // (Escape/close button/backdrop) before the auto-close fired.
    if (pendingRefresh) {
      pendingRefresh = false;
      refreshDashboard();
    }
  }

  window.openQuickWriteModal = (defaultTab = 'weight') => {
    if (!modal) return;
    // Guard against a stale auto-close timer from a previous session.
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
    lastFocused = document.activeElement as HTMLElement | null;
    modal.hidden = false;
    // The page behind the modal must not scroll on touch.
    document.body.style.overflow = 'hidden';
    // Buttons may still be disabled after a successful submission.
    modal.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach((b) => {
      b.disabled = false;
    });
    activateTab(defaultTab);
    setNowDefaults();
    // Focus on the active tab — the first interactive element of the dialog.
    modal.querySelector<HTMLElement>('.tab-btn.active')?.focus();
  };

  /**
   * Refresh the dashboard after a write WITHOUT reload: page reload resets the
   * selected day (?date= is read only on startup, setDate does not write to URL).
   * On the day page we re-dispatch gh:date (DayTimeline and MiscCard only listen
   * to onDate) and silently re-read the summary.
   */
  function refreshDashboard(): void {
    const page = document.querySelector('.topbar')?.getAttribute('data-page') ?? 'day';
    if (page === 'day') {
      const d = getDate();
      window.dispatchEvent(new CustomEvent('gh:date', { detail: { date: d } }));
      void loadSummary(d);
    } else {
      window.location.reload();
    }
  }

  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Escape closes; Tab cycles within the modal (focus trap).
  modal?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      closeModal();
      return;
    }
    if (e.key !== 'Tab' || !modalCard) return;
    const focusables = modalCard.querySelectorAll<HTMLElement>(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
    );
    // Visible only: inactive tabs are hidden (display:none -> offsetParent null).
    const list = [...focusables].filter((el) => el.offsetParent !== null);
    if (list.length === 0) return;
    const first = list[0];
    const last = list[list.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  function activateTab(tabName: string) {
    tabs.forEach(t => {
      const on = t.getAttribute('data-tab') === tabName;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', String(on));
    });
    contents.forEach(c => c.classList.toggle('active', c.id === `form-${tabName}`));
    if (statusBox) statusBox.hidden = true;
  }

  tabs.forEach(t => {
    t.addEventListener('click', () => {
      const tab = t.getAttribute('data-tab');
      if (tab) activateTab(tab);
    });
  });

  // Arrow keys/Home/End switch tabs (WAI-ARIA tabs pattern).
  const tabList = modal?.querySelector<HTMLElement>('.modal-tabs');
  tabList?.addEventListener('keydown', (e) => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
    const tabArr = [...tabs] as HTMLElement[];
    const idx = tabArr.indexOf(document.activeElement as HTMLElement);
    if (idx === -1) return;
    e.preventDefault();
    let next = idx;
    if (e.key === 'ArrowRight') next = (idx + 1) % tabArr.length;
    else if (e.key === 'ArrowLeft') next = (idx - 1 + tabArr.length) % tabArr.length;
    else if (e.key === 'Home') next = 0;
    else next = tabArr.length - 1;
    tabArr[next].focus();
    const tab = tabArr[next].getAttribute('data-tab');
    if (tab) activateTab(tab);
  });

  function setNowDefaults() {
    // datetime-local is interpreted as LOCAL time, so building the value from
    // toISOString() (UTC) is not possible — in UTC+3 the entry would be 3 hours
    // earlier (and near midnight — on the previous day).
    const d = new Date();
    const pad = (x: number) => String(x).padStart(2, '0');
    const now = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    // Update on every opening: a stale "now" value can easily be submitted by accident.
    ['weight-time', 'hydration-time', 'nutrition-time'].forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement;
      if (el) el.value = now;
    });
  }

  // Form submission handling
  const forms = [
    { id: 'form-weight', action: 'add_weight' },
    { id: 'form-hydration', action: 'add_hydration' },
    { id: 'form-sleep', action: 'add_sleep' },
    { id: 'form-exercise', action: 'add_exercise' },
    { id: 'form-nutrition', action: 'add_nutrition' },
  ];

  forms.forEach(({ id, action }) => {
    const form = document.getElementById(id) as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Double-submit guard: a repeated click creates duplicate records.
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn?.disabled) return;
      if (btn) btn.disabled = true;
      const formData = new FormData(form);
      const data: Record<string, any> = { action };
      formData.forEach((val, key) => {
        if (key.includes('Time') || key === 'timestamp') {
          const d = new Date(val as string);
          data[key] = val && !Number.isNaN(d.getTime()) ? d.toISOString() : undefined;
        } else {
          data[key] = val;
        }
      });
      // The actual utcOffset of the record (not "0s"): Google derives the civil
      // date from it, otherwise a nighttime entry in UTC+ would shift to the previous day.
      const ref = new Date((formData.get('startTime') ?? formData.get('timestamp') ?? '') as string);
      const base = Number.isNaN(ref.getTime()) ? new Date() : ref;
      data.utcOffset = `${-base.getTimezoneOffset() * 60}s`;

      try {
        if (statusBox) {
          statusBox.hidden = false;
          statusBox.textContent = 'Saving...';
          statusBox.className = 'status-box pending';
        }
        const resp = await fetch('/api/write', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const res = await resp.json();
        if (res.success) {
          if (statusBox) {
            statusBox.textContent = res.note ? `Saved. ${res.note}` : 'Saved successfully!';
            statusBox.className = 'status-box success';
          }
          // Do NOT unlock the button before closing: a repeated click within
          // these 1.2s would create a duplicate record. openQuickWriteModal
          // will unlock it.
          pendingRefresh = true;
          if (closeTimer) clearTimeout(closeTimer);
          closeTimer = setTimeout(() => closeModal(), 1200);
        } else {
          throw new Error(res.error || 'Write error');
        }
      } catch (err: any) {
        if (statusBox) {
          statusBox.hidden = false;
          statusBox.textContent = err.message;
          statusBox.className = 'status-box error';
        }
        if (btn) btn.disabled = false;
      }
    });
  });

  // RAW Form
  const rawForm = document.getElementById('form-raw') as HTMLFormElement;
  rawForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const rawBtn = rawForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (rawBtn?.disabled) return;
    if (rawBtn) rawBtn.disabled = true;
    const dataType = (rawForm.querySelector('[name="dataType"]') as HTMLInputElement).value;
    const bodyStr = (rawForm.querySelector('[name="body"]') as HTMLTextAreaElement).value;

    // Show status BEFORE parsing: otherwise a JSON.parse error writes to
    // a hidden block and the user gets no feedback.
    if (statusBox) {
      statusBox.hidden = false;
          statusBox.textContent = 'Submitting...';
      statusBox.className = 'status-box pending';
    }
    try {
      const parsedBody = JSON.parse(bodyStr);
      const resp = await fetch('/api/write', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'raw_create', dataType, body: parsedBody })
      });
      const res = await resp.json();
      if (res.success) {
        if (statusBox) {
          statusBox.textContent = 'Data point created!';
          statusBox.className = 'status-box success';
        }
        pendingRefresh = true;
        if (closeTimer) clearTimeout(closeTimer);
        closeTimer = setTimeout(() => closeModal(), 1200);
      } else {
        throw new Error(res.error || 'Creation error');
      }
    } catch (err: any) {
      if (statusBox) {
        statusBox.hidden = false;
        statusBox.textContent = err.message;
        statusBox.className = 'status-box error';
      }
      if (rawBtn) rawBtn.disabled = false;
    }
  });
</script>

<style>
  .modal-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow-y: auto;
  }

  .modal-card {
    width: 100%;
    max-width: 520px;
    margin: auto;
    background: var(--bg);
    border: 1px solid var(--border-hover);
    border-radius: 2px;
    padding: 24px;
    box-shadow: 0 0 0 1px #000, 0 24px 48px rgba(0, 0, 0, 0.7);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .modal-header h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .modal-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .tab-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-faint);
    padding: 6px 12px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .tab-btn:hover { color: var(--text); border-color: var(--border-hover); }
  .tab-btn:active { background: var(--text); color: #000; border-color: var(--text); }
  .tab-btn.active {
    background: var(--text);
    color: #000;
    border-color: var(--text);
  }

  .tab-content {
    display: none;
    flex-direction: column;
    gap: 12px;
  }
  .tab-content.active {
    display: flex;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  input, select, textarea {
    background: var(--panel-2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 8px 12px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  input:focus:not(:focus-visible), select:focus:not(:focus-visible), textarea:focus:not(:focus-visible) {
    outline: none;
  }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 1px solid var(--text-dim);
    outline-offset: 1px;
    border-color: var(--text-dim);
  }

  .submit-btn {
    background: var(--text);
    color: #000;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    padding: 10px;
    border-radius: 2px;
    cursor: pointer;
    margin-top: 8px;
    transition: opacity 0.15s ease;
  }
  .submit-btn:hover { opacity: 0.85; }
  .submit-btn:active { opacity: 0.7; }

  .form-hint {
    margin: 0;
    font-size: 10px;
    line-height: 1.5;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }

  .status-box {
    margin-top: 12px;
    padding: 8px 12px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    border: 1px solid var(--border);
  }
  .status-box.pending { background: transparent; color: var(--text-dim); }
  .status-box.success { background: rgba(242, 242, 242, 0.06); color: var(--text); }
  .status-box.error {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent-text);
  }

  /* Mobile: tighter card, compact tabs — otherwise RAW goes off the edge
     of the tab row with no scroll hint. */
  @media (max-width: 480px) {
    .modal-card { padding: 16px; }
    .modal-tabs { gap: 4px; }
    .tab-btn { padding: 7px 8px; }
  }
</style>
